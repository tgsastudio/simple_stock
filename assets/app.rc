1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 1,2,1,0
PRODUCTVERSION 1,2,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "tgsastudio"
            VALUE "FileDescription", "Stock TW - Lightweight Stock Dashboard"
            VALUE "FileVersion", "1.2.1.0"
            VALUE "InternalName", "simple_stock"
            VALUE "OriginalFilename", "simple_stock.exe"
            VALUE "ProductName", "Stock TW"
            VALUE "ProductVersion", "1.2.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
